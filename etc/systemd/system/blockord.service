[Unit]
Description=Blockord Service
# Start after nftables.service loads /etc/nftables.conf, so its
# "flush ruleset" cannot wipe the tables blockord creates, and after
# ufw and firewalld are up, so firewall="auto" can find them.
After=network.target nftables.service ufw.service firewalld.service

[Service]
ExecStart=/usr/local/libexec/blockor/blockord.sh
Restart=always
RestartSec=5
# blockord exits 78 (EX_CONFIG) when it cannot find sshd to read the
# journal for. Restarting would not change that, so stay stopped.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
