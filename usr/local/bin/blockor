#!/bin/sh
#
# Copyright (c) 2022-2022, Muktadiur Rahman <muktadiur@gmail.com>
# All rights reserved.

## version
version='0.1.2'

PATH=${PATH}:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin

. /usr/local/etc/blockor.conf
. /usr/local/libexec/blockor/blockor_lib.sh

blockor_usage() {
    cat << EOF
Blockor protects Linux servers from brute-force attacks.
Usage:
  blockor command [args]
Available Commands:
  init          To initialize the blockor firewall rules.
  start         Start the blockord daemon.
  stop          Stop the blockord daemon.
  restart       Restart the blockord daemon.
  enable        Start the blockord daemon at boot.
  disable       Not start the blockord daemon at boot.
  add           Add IP to blocked list.
  remove        Remove IP from blocked list.
  flush         Remove all entries from blocked list.
  list          Show blocked list with the failed count.
  status        Running or Stopped, with the firewall and log in use.
Use "blockor -v|--version" for version information.
EOF
    exit 1
}

permission_check() {
    if [ $(id -u) -ne 0 ]; then
        echo "blockor(permission denied). root|doas|sudo required"
        exit 1
    fi
}

# Pick the firewall (nftables, ufw, firewalld or iptables) or stop.
require_fw() {
    if ! fw_setup; then
        echo "blockor($fw_error)"
        exit 1
    fi
}

blockor_version() {
    echo "blockor(${version})"
    exit 0
}

blockor_init() {
    if ! fw_init; then
        echo "blockor(init failed. $FW)"
        exit 1
    fi
    echo "blockor(ok)"
    echo "firewall($FW)"
    exit 0
}

# Print firewall(...) and log(...) lines for status and check.
show_backends() {
    if fw_setup; then
        echo "firewall($FW)"
    else
        echo "firewall(none. $fw_error)"
    fi
    if ! log_setup; then
        echo "log(none. $log_error)"
    elif [ "$log_from" = file ]; then
        echo "log($auth_file)"
    else
        echo "log(journal)"
    fi
}

blockor_check() {
    blockor_conf="/usr/local/etc/blockor.conf"
    if [ ! -r $blockor_conf ]; then
        echo "blockor($blockor_conf not found)"
        echo "example: /usr/local/share/examples/blockor/blockor.example.conf"
        exit 1
    fi

    echo "blockor(ok)"
    if [ -z "$blockor_whitelist" ]; then
        echo "warning: blockor_whitelist is empty in $blockor_conf."
        echo "Add your own IP so a few mistyped passwords cannot lock you out."
    fi
    show_backends
    exit 0
}

blockor_start() {
    if [ $(ps ax | awk '/libexec/ && /blockord.sh/' | grep -v awk | wc -l) -gt 0 ]; then
        echo 'blockord(already running)'
        exit 1
    fi
    systemctl start blockord
    echo 'blockord(running)'
}

blockor_stop() {
    systemctl stop blockord
    echo 'blockord(stopped)'
}

# Print $1 back if it is an IPv4 or IPv6 address, nothing otherwise.
parse_ip() {
    echo "$1" | grep -xE '([0-9]{1,3}\.){3}[0-9]{1,3}|[0-9a-fA-F]*:[0-9a-fA-F:]*:[0-9a-fA-F.]*'
}

blockor_add() {
    if is_whitelisted "$1"; then
        echo "blockor(whitelisted. skipped. $1)"
        return
    fi
    fw_has "$1" || fw_add "$1"
}

blockor_remove() {
    fw_remove "$1" || return 1
    if [ -f "$blockor_file" ]; then
        # mktemp, not a fixed name: a fixed name next to a count file in a
        # shared directory can be planted as a symlink.
        tmp=$(mktemp "$blockor_file.XXXXXX") || return
        # Drop every spelling of the address (2001:db8::1, 2001:DB8:0::1).
        awk -v drop="$1" "$norm_awk"'
            BEGIN { drop = norm(drop) }
            norm($1) != drop' "$blockor_file" > "$tmp"
        cat "$tmp" > "$blockor_file"
        rm -f "$tmp"
    fi
}

blockor_flush() {
    if ! fw_flush; then
        echo "blockor(flush failed. $FW)" >&2
        exit 1
    fi
    if [ -f "$blockor_file" ]; then
        : > "$blockor_file"
    fi
    echo 'blockor(flushed)'
    exit 0
}

blockor_list() {
    echo 'Blocked IP(s):'
    fw_list | sed 's/^/  /'

    if [ -f "$blockor_file" ]; then
        echo "count  IP"
        sort "$blockor_file" | uniq -c | sort -nr
    fi
    exit 0
}

blockor_status() {
    status='stopped'
    if [ $(ps ax | awk '/libexec/ && /blockord.sh/' | grep -v awk | wc -l) -gt 0 ]; then
        status='running'
    fi
    echo 'blockord('$status'.'$(systemctl is-enabled blockord)')'
    show_backends
    exit 0
}

blockor_eanble() {
    systemctl enable blockord
    echo 'blockord(enabled)'
}

blockor_disable() {
    systemctl disable blockord
    echo 'blockord(disabled)'
}

blockor_restart() {
    blockor_stop
    blockor_start
    exit 0
}

# Every argument must be an IP address.
check_ips() {
    if [ $# -lt 1 ]; then
        echo 'blockor(invalid IP)'
        exit 1
    fi
    for arg in "$@"; do
        if [ -z "$(parse_ip "$arg")" ]; then
            echo "blockor(invalid IP. $arg)"
            exit 1
        fi
    done
}

[ $# -lt 1 ] && blockor_usage

CMD=$1
shift

case ${CMD} in
version|-v|--version)
    blockor_version
    ;;
help|-h|--help)
    blockor_usage
    ;;
check|--check)
    permission_check
    blockor_check
    ;;
init|--init)
    permission_check
    require_fw
    blockor_init
    ;;
start|--start)
    permission_check
    require_fw
    blockor_start
    exit 0
    ;;
stop|--stop)
    permission_check
    blockor_stop
    exit 0
    ;;
restart|--restart)
    permission_check
    require_fw
    blockor_restart
    ;;
add|-a|--add)
    permission_check
    require_fw
    check_ips "$@"
    if ! fw_init >/dev/null; then
        echo "blockor(init failed. $FW)"
        exit 1
    fi
    failed=0
    for ip in "$@"; do
        if ! blockor_add "$ip"; then
            echo "blockor(add failed. $ip)" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ] || exit 1
    echo 'blockor(ok)'
    exit 0
    ;;
remove|-r|--remove)
    permission_check
    require_fw
    check_ips "$@"
    failed=0
    for ip in "$@"; do
        if ! blockor_remove "$ip"; then
            echo "blockor(remove failed. $ip)" >&2
            failed=1
        fi
    done
    [ "$failed" -eq 0 ] || exit 1
    echo 'blockor(removed)'
    exit 0
    ;;
flush|-f|--flush)
    permission_check
    require_fw
    blockor_flush
    ;;
list|-l|--list)
    permission_check
    require_fw
    blockor_list
    ;;
status|-s|--status)
    permission_check
    blockor_status
    ;;
enable|-e|--enable)
    permission_check
    blockor_eanble
    ;;
disable|-d|--disable)
    permission_check
    blockor_disable
    ;;
*)
    blockor_usage
    ;;
esac
